# Carbon 阶段一：厂内局域网部署配置
# ================================================
# 用途：厂内员工通过 IP 地址访问，无需域名和 HTTPS
#
# 用法：
#   1. cp .env.stage1.example .env
#   2. 编辑 .env，替换所有 [REQUIRED] 项
#   3. docker compose -f docker-compose.stage1.yml --env-file .env up -d

# ============================================================
# 服务器配置 [REQUIRED]
# ============================================================

# 服务器 IP 地址（厂内局域网 IP）
SERVER_IP=192.168.1.100

# ============================================================
# 数据库配置 [REQUIRED]
# ============================================================

# PostgreSQL 密码（必须修改！）
# 生成方式：openssl rand -base64 32
POSTGRES_PASSWORD=your_strong_password_here

# 数据库名称
POSTGRES_DB=postgres

# 数据库端口（可选，用于调试）
PORT_DB=5432

# ============================================================
# Redis 配置 [REQUIRED]
# ============================================================

# Redis 密码（必须修改！）
# 生成方式：openssl rand -hex 32
REDIS_PASSWORD=your_redis_password_here

# ============================================================
# Supabase 配置 [REQUIRED]
# ============================================================

# JWT 密钥（必须修改！至少 32 字符）
# 生成方式：openssl rand -base64 48
SUPABASE_JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Realtime 密钥（必须修改！）
# 生成方式：openssl rand -hex 32
REALTIME_SECRET_KEY_BASE=your_realtime_secret_key_base

# Anon Key（前端使用）
# 生成方式：使用 JWT 密钥签名
# 工具：https://jwt.io/
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service Role Key（服务端使用，不要暴露到前端！）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ============================================================
# 应用配置
# ============================================================

# Session 密钥（必须修改！）
# 生成方式：openssl rand -hex 32
SESSION_SECRET=your_session_secret_here

# Carbon 版本
CARBON_EDITION=community

# ============================================================
# Inbucket 邮件配置（阶段一使用）
# ============================================================

# Inbucket Web UI 端口
PORT_INBUCKET=9000

# Inbucket SMTP 端口
PORT_SMTP=2500

# ============================================================
# Studio 配置
# ============================================================

# Supabase Studio 端口
PORT_STUDIO=3000

# ============================================================
# 可选配置（阶段一暂不需要）
# ============================================================

# OAuth 配置（阶段二启用）
# GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# 真实 SMTP 配置（阶段二启用）
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=

# Inngest 配置（阶段二启用）
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# 第三方服务（按需配置）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
