###############################################################################
# Carbon Swarm stack - NON-SECRET configuration.
#
# Copy to `.env` and fill in. `deploy.sh` sources this file and exports it so
# `docker stack deploy` can interpolate values in docker-compose.prod.yml.
# Credentials are Docker Swarm secrets created by `deploy.sh init`; they never
# belong in this file.
###############################################################################

# Absolute path to the Carbon checkout on this Ubuntu host.
CARBON_REPO=/opt/carbon

# Swarm stack name (prefix for services, networks, and volumes).
STACK_NAME=carbon

# Hostnames must have DNS A/AAAA records pointing at this host.
DOMAIN=example.com
ERP_HOST=erp.example.com
MES_HOST=mes.example.com
SUPABASE_HOST=api.example.com
# Optional Studio host. Leave blank to keep Studio internal-only.
STUDIO_HOST=

# Public URLs used by Carbon and GoTrue.
ERP_URL=https://erp.example.com
MES_URL=https://mes.example.com
SUPABASE_URL=https://api.example.com

# Email used for Let's Encrypt / ACME registration.
ACME_EMAIL=admin@example.com

# Application configuration.
CARBON_EDITION=community
RESEND_DOMAIN=example.com

# U8 SQL Server integration (optional). U8_PASSWORD is a Swarm secret.
U8_SERVER=
U8_PORT=1433
U8_DATABASE=
U8_USER=

# Container images. Leave CARBON_REGISTRY blank to build locally on the host.
CARBON_REGISTRY=
CARBON_IMAGE_ERP=carbon/erp:latest
CARBON_IMAGE_MES=carbon/mes:latest

# Outbound email for GoTrue. The SMTP password is a Swarm secret.
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com
GOTRUE_SMTP_SENDER_NAME=Carbon
GOTRUE_DISABLE_SIGNUP=true

# Sign-in methods shown on the login screen: email, google, azure, passkey.
AUTH_PROVIDERS=email,google,azure

# OAuth is optional. Client secrets are Swarm secrets; only IDs and URLs live here.
GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=
AZURE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_REDIRECT_URI=

# Set to 0 to disable the internal Supabase Studio service.
STUDIO_REPLICAS=1

# PostgreSQL tuning. Defaults suit a host with about 4 GB available to Postgres.
# Keep work_mem * max_connections below roughly 25 percent of total host RAM.
PG_MEMORY_LIMIT=2048M
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB

# Edge functions. Only explicitly listed public functions bypass JWT validation.
EDGE_VERIFY_JWT=true
EDGE_JWT_DISABLED_FUNCTIONS=image-resizer,logo-resizer
