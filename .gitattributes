# Enforce LF line endings for files that must be LF in Linux containers.
# Without this, Git on Windows checks out CRLF, which breaks shell scripts
# running inside Docker (the entrypoint.sh error: "Syntax error: end of file
# unexpected (expecting \"then\")" is the classic symptom).

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Deno/TypeScript edge functions - Deno is strict about line endings
packages/dev/docker/edge-main/** text eol=lf

# Docker entrypoints
packages/dev/docker/** text eol=lf
