# Carbon 生产环境配置
# ================================================
# 用法:
#   1. cp .env.production.example .env.production
#   2. 编辑所有带 [REQUIRED] 的变量
#   3. 生成密钥: openssl rand -hex 32
#   4. docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# 安全提示:
#   - 此文件不要提交到 git
#   - 所有密钥必须是随机生成，不要使用默认值
#   - POSTGRES_PASSWORD、REDIS_PASSWORD、JWT_SECRET 必须更改

# ============================================================
# 域名与 URL
# ============================================================

# 根域名 [REQUIRED]
DOMAIN=erp.yourcompany.com

# ERP 和 MES 访问 URL [REQUIRED]
ERP_URL=https://erp.yourcompany.com
MES_URL=https://mes.yourcompany.com

# Supabase API URL (通过 Kong) [REQUIRED]
SUPABASE_URL=https://api.yourcompany.com

# ============================================================
# 数据库 [REQUIRED]
# ============================================================

# PostgreSQL 密码 — 必须更改!
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# 数据库名称
POSTGRES_DB=postgres

# ============================================================
# Redis [REQUIRED]
# ============================================================

# Redis 密码 — 必须更改!
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ============================================================
# Supabase 密钥 [REQUIRED]
# ============================================================

# JWT 密钥 — 必须更改! 最少 32 字符
# 生成: openssl rand -base64 48
SUPABASE_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_characters_long

# Anon Key (前端使用)
# 生成: node -e "console.log(require('jsonwebtoken').sign({iss:'supabase',role:'anon',exp:Math.floor(Date.now()/1000)+86400}, process.env.SECRET))"
SUPABASE_ANON_KEY=CHANGE_ME_generate_with_jwt_secret

# Service Role Key (仅服务端使用，不要暴露到浏览器!)
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_generate_with_jwt_secret

# Realtime 密钥 [REQUIRED]
# 生成: openssl rand -hex 32
REALTIME_SECRET_KEY_BASE=CHANGE_ME_realtime_secret_key

# ============================================================
# 应用安全 [REQUIRED]
# ============================================================

# Session 加密密钥 [REQUIRED]
# 生成: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_session_secret

# Carbon 版本
CARBON_EDITION=community

# ============================================================
# SMTP 邮件 [REQUIRED for production]
# ============================================================

# 生产环境使用真实 SMTP (不要用 Inbucket)
# 推荐: Resend, SendGrid, AWS SES, or your own SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_ADMIN_EMAIL=admin@yourcompany.com

# ============================================================
# Resend (如果 SMTP 不可用)
# ============================================================

RESEND_API_KEY=
RESEND_DOMAIN=yourcompany.com

# ============================================================
# OAuth (可选)
# ============================================================

GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=

# ============================================================
# Inngest 后台任务
# ============================================================

# 推荐使用 Inngest Cloud (最少配置):
#   注册: https://www.inngest.com/
#   设置 INNGEST_SIGNING_KEY 和 INNGEST_EVENT_KEY
#
# 或者使用自托管 dev 模式 (仅限小规模/测试):
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ============================================================
# 监控与分析 (可选)
# ============================================================

POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_PUBLIC_KEY=

# ============================================================
# AI 服务 (可选)
# ============================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================================
# 安全与防护 (可选)
# ============================================================

CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ============================================================
# 端口映射
# ============================================================

# HTTP/HTTPS 端口 (Caddy)
PORT_HTTP=80
PORT_HTTPS=443

# 以下端口默认不暴露到宿主机 (在 docker-compose.prod.yml 中注释掉了)
# 如需调试，取消对应端口映射的注释
PORT_DB=5432
PORT_REDIS=6379
PORT_STUDIO=3000

# ============================================================
# 第三方集成 (可选)
# ============================================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SLACK_BOT_TOKEN=

GOOGLE_PLACES_API_KEY=
